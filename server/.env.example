# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Email Configuration (for notifications)
# Choose email service: 'sendgrid' (recommended) or 'smtp'
EMAIL_SERVICE=sendgrid
EMAIL_FROM=your_email@example.com

# SendGrid Configuration (recommended - works over HTTPS, no port blocking)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SMTP Configuration (alternative - may be blocked by some hosting providers)
# Uncomment and set EMAIL_SERVICE=smtp to use SMTP instead
# EMAIL_PASSWORD=your_smtp_app_password_here
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Scheduler Configuration
CHECK_INTERVAL_MINUTES=15

# Optional: Recreation.gov API Key
# RECREATION_GOV_API_KEY=your_api_key_here
