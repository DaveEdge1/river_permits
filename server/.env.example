# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-secret-in-production

# JWT Configuration (for mobile app authentication)
# Generate a secure random string for production
JWT_SECRET=change-this-jwt-secret-in-production

# ===========================================
# EMAIL NOTIFICATIONS
# ===========================================

# Choose email service: 'sendgrid' (recommended) or 'smtp'
EMAIL_SERVICE=sendgrid
EMAIL_FROM=your_email@example.com

# SendGrid Configuration (recommended - works over HTTPS, no port blocking)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SMTP Configuration (alternative - may be blocked by some hosting providers)
# Uncomment and set EMAIL_SERVICE=smtp to use SMTP instead
# EMAIL_PASSWORD=your_smtp_app_password_here
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# ===========================================
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ===========================================

# Firebase Admin SDK credentials
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ===========================================
# SCHEDULER
# ===========================================

# How often to check for permits (in minutes)
CHECK_INTERVAL_MINUTES=15

# ===========================================
# OPTIONAL
# ===========================================

# Recreation.gov API Key (optional - may help with rate limits)
# RECREATION_GOV_API_KEY=your_api_key_here

# SMS Notifications via Twilio (optional)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890
# TWILIO_TO_NUMBER=+1234567890
